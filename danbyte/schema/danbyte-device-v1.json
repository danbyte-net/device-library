{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danbyte-net/device-library/danbyte/schema/danbyte-device-v1.json",
  "title": "Danbyte device bundle, version 1",
  "description": "Everything that makes one hardware model work in Danbyte: component templates, faceplate layout, photo-anchored port markers, inventory templates and vendor SNMP health sensors. Carries no credentials.",
  "type": "object",
  "required": ["danbyte_device_type", "name"],
  "additionalProperties": false,
  "properties": {
    "danbyte_device_type": { "const": 1, "description": "Format version." },
    "name": { "type": "string", "minLength": 1, "description": "The device type's identity. Matched by name on import." },
    "manufacturer": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "part_number": { "type": ["string", "null"] },
    "u_height": { "type": ["number", "null"], "minimum": 0 },
    "rack_width": { "type": ["string", "null"], "enum": ["10", "19", "21", "23", "full", "half", null] },
    "is_full_depth": { "type": ["boolean", "null"] },
    "airflow": { "type": ["string", "null"] },
    "weight": { "type": ["number", "string", "null"] },
    "weight_unit": { "type": ["string", "null"] },
    "subdevice_role": { "type": ["string", "null"] },
    "exclude_from_utilization": { "type": ["boolean", "null"] },
    "description": { "type": ["string", "null"] },

    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interfaces": { "$ref": "#/$defs/componentList" },
        "console_ports": { "$ref": "#/$defs/componentList" },
        "console_server_ports": { "$ref": "#/$defs/componentList" },
        "aux_ports": { "$ref": "#/$defs/componentList" },
        "power_ports": { "$ref": "#/$defs/componentList" },
        "power_outlets": { "$ref": "#/$defs/componentList" },
        "rear_ports": { "$ref": "#/$defs/componentList" },
        "front_ports": {
          "type": "array",
          "items": {
            "allOf": [{ "$ref": "#/$defs/component" }],
            "required": ["name", "rear_port"],
            "description": "rear_port names a rear port in THIS bundle — a front port cannot exist without it."
          }
        },
        "module_bays": { "$ref": "#/$defs/componentList" },
        "device_bays": { "$ref": "#/$defs/componentList" },
        "inventory_items": { "$ref": "#/$defs/componentList" }
      }
    },

    "faceplate": {
      "type": ["object", "null"],
      "description": "The millimetre-true port layout (Danbyte FaceplateDoc)."
    },
    "image_ports": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Port markers on the device photo. Coordinates are normalized 0..1 and centre-anchored, so they scale to any render size and into the 3D view.",
      "properties": {
        "front": { "$ref": "#/$defs/markerList" },
        "rear": { "$ref": "#/$defs/markerList" }
      }
    },
    "sensors": { "type": "array", "items": { "$ref": "#/$defs/sensor" } },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "description": "Whether the markers were placed against a front/rear photo. Danbyte's exporter emits `true`/`false` (it can't know a path); a bundle published in this library replaces that with a repo-relative path to the photo, so an importer can find it. Either form is valid — the importer only needs to know the photo EXISTED, because marker coordinates are meaningless without it.",
      "properties": {
        "front": { "type": ["boolean", "string"] },
        "rear": { "type": ["boolean", "string"] }
      }
    },
    "contributed_by": { "type": "string" },
    "danbyte_version": { "type": "string" }
  },

  "$defs": {
    "component": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "type": { "type": ["string", "null"] }
      }
    },
    "componentList": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "markerList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "x", "y", "w", "h"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["interface", "console-port", "console-server-port", "power-port", "power-outlet", "front-port", "rear-port", "aux-port", "inventory-item"]
          },
          "name": { "type": "string", "minLength": 1 },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "sensor": {
      "type": "object",
      "required": ["name", "slug", "oid"],
      "additionalProperties": false,
      "description": "A vendor health OID and its value map. NO CREDENTIALS: polls with the importing deployment's own SNMP profile. Always imported observe-only.",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "oid": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)+$" },
        "walk": { "type": "boolean" },
        "item_kind": {
          "type": "string",
          "enum": ["other", "disk", "cpu", "ram", "psu", "fan", "gpu", "controller", "transceiver"]
        },
        "name_template": { "type": "string" },
        "value_map": { "type": "object", "additionalProperties": { "type": "string" } },
        "absent_status": { "type": ["string", "null"] },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
